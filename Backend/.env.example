# Runturfing Backend — copy to .env and fill in. NEVER commit .env.
# Key names match api/config.py Settings fields exactly (pydantic-settings):
# unknown keys or non-JSON list values will crash startup.

# PostgreSQL / Supabase connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# JWT — generate secret with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=10080

# Stripe (server-side secret key + webhook signing secret)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Must match the Authorization header set on the RevenueCat webhook
REVENUECAT_WEBHOOK_AUTH=Bearer CHANGE_ME

# Apple Sign In (server-side token verification; APPLE_PRIVATE_KEY = PEM content, not a path)
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_CLIENT_ID=com.runturfing.app
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY=

# App
DEBUG=false
# Must be a JSON array — pydantic parses List[str] fields as JSON
ALLOWED_ORIGINS=["http://localhost:3000","https://runturfing.app"]
