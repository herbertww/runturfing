# Copy to .env and fill in your values

# Backend API
EXPO_PUBLIC_API_BASE_URL=https://your-backend.railway.app

# Stripe (publishable key only — never put secret key here)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY

# RevenueCat public SDK keys (Project settings > API keys). These are meant to
# ship in the app. A Test Store key (test_...) works on both platforms in dev.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_YOUR_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_YOUR_KEY

# Google Maps (Android)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# EAS project ID (from `eas init`)
EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID

# Shows the "Skip Login" button in RELEASE builds for sideloaded testing.
# MUST be false (or absent) for any build that goes to the Play Store.
EXPO_PUBLIC_ALLOW_DEV_BYPASS=false
